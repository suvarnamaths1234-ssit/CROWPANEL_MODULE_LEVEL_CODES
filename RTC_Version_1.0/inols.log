l":"void (int)","kind":6,"range":{"start":{"line":273,"character":0},"end":{"line":276,"character":1}},"selectionRange":{"start":{"line":273,"character":20},"end":{"line":273,"character":37}}},{"name":"JarController::saveSettings","detail":"bool (const char *)","kind":6,"range":{"start":{"line":279,"character":0},"end":{"line":357,"character":1}},"selectionRange":{"start":{"line":279,"character":20},"end":{"line":279,"character":32}}},{"name":"JarController::markUnsaved","detail":"void ()","kind":6,"range":{"start":{"line":359,"character":0},"end":{"line":364,"character":1}},"selectionRange":{"start":{"line":359,"character":20},"end":{"line":359,"character":31}}},{"name":"JarController::bindInfoPageUI","detail":"void (lv_obj_t *, lv_obj_t *, lv_obj_t *, lv_obj_t *, lv_obj_t *)","kind":6,"range":{"start":{"line":366,"character":0},"end":{"line":372,"character":1}},"selectionRange":{"start":{"line":366,"character":20},"end":{"line":366,"character":34}}},{"name":"JarController::bindHomePageUI","detail":"void (lv_obj_t *, lv_obj_t *)","kind":6,"range":{"start":{"line":374,"character":0},"end":{"line":377,"character":1}},"selectionRange":{"start":{"line":374,"character":20},"end":{"line":374,"character":34}}},{"name":"JarController::getElapsedTime","detail":"unsigned long () const","kind":6,"range":{"start":{"line":379,"character":0},"end":{"line":382,"character":1}},"selectionRange":{"start":{"line":379,"character":29},"end":{"line":379,"character":43}}},{"name":"JarController::getRemainingTime","detail":"unsigned long () const","kind":6,"range":{"start":{"line":384,"character":0},"end":{"line":392,"character":1}},"selectionRange":{"start":{"line":384,"character":29},"end":{"line":384,"character":45}}},{"name":"JarController::updateUIFields","detail":"void ()","kind":6,"range":{"start":{"line":394,"character":0},"end":{"line":406,"character":1}},"selectionRange":{"start":{"line":394,"character":20},"end":{"line":394,"character":34}}},{"name":"JarController::updateHomePa