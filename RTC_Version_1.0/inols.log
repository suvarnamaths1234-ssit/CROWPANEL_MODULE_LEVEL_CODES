geUI","detail":"void ()","kind":6,"range":{"start":{"line":410,"character":0},"end":{"line":435,"character":1}},"selectionRange":{"start":{"line":410,"character":20},"end":{"line":410,"character":36}}},{"name":"JarController::updateButtonStates","detail":"void (bool)","kind":6,"range":{"start":{"line":437,"character":0},"end":{"line":465,"character":1}},"selectionRange":{"start":{"line":437,"character":20},"end":{"line":437,"character":38}}},{"name":"JarController::onTimerTick","detail":"void ()","kind":6,"range":{"start":{"line":467,"character":0},"end":{"line":470,"character":1}},"selectionRange":{"start":{"line":467,"character":20},"end":{"line":467,"character":31}}}]}
