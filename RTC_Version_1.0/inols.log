{"jsonrpc":"2.0","method":"textDocument/didSave","params":{"textDocument":{"uri":"file:///c%3A/Users/user/Documents/crowpanel_display/version_5/ErrorManager.cpp","version":10},"text":"#include \"RTCManager.h\"\r\n\r\nRTCManager rtcManager;   // Global instance (matches `extern` in .h)\r\n\r\nRTCManager::RTCManager()\r\n    : rtcReady(false),\r\n      calendar_popup(nullptr),\r\n      calendar_year_roller(nullptr),\r\n      calendar_month_roller(nullptr),\r\n      calendar_day_roller(nullptr),\r\n      calendar_hour_roller(nullptr),\r\n      calendar_minute_roller(nullptr),\r\n      update_timer(nullptr),\r\n      home_time_label(nullptr),\r\n      settings_button(nullptr),\r\n      errorManager(nullptr)\r\n{\r\n}\r\n\r\nbool RTCManager::begin(int sda_pin, int scl_pin) {\r\n    Wire.begin(sda_pin, scl_pin);\r\n\r\n    if (!rtc.begin()) {\r\n        Serial.println(\"RTC init failed!\");\r\n        rtcReady = false;\r\n        if (errorManager) {\r\n            errorManager->logError(ERR_DISPLAY_FAILED, 0, \"RTC init failed\");\r\n        }\r\n        return false;\r\n    }\r\n\r\n    // If RTC lost power, set it to compile time (or you can set manually later)\r\n    if (rtc.lostPower()) {\r\n        Serial.println(\"RTC lost power, setting time to compile time\");\r\n        rtc.adjust(DateTime(F(__DATE__), F(__TIME__)));\r\n    }\r\n\r\n    rtcReady = true;\r\n\r\n    // Optional internal timer – you can also just call updateHomePageTime() from your main timer_cb\r\n    update_timer = lv_timer_create(RTCManager::timerCallback, 1000, this);\r\n\r\n    Serial.println(\"RTC initialized successfully\");\r\n    return true;\r\n}\r\n\r\nvoid RTCManager::bindUI(lv_obj_t *home_time, lv_obj_t *settings_btn) {\r\n    home_time_label = home_time;\r\n    settings_button = settings_btn;\r\n\r\n    Serial.printf(\"RTC UI bound - home_time_label: %p, settings_button: %p\\n\",\r\n                  home_time_label, settings_button);\r\n\r\n    // Initial UI update\r\n    updateHomePageTime();\r\n    updateSettingsButton();\r\n}\r\n\r\nvoid RTCManager::setErrorManager(ErrorManager *em) {\r\n    errorManager = em;\r\n}\r\n\r\nDateTime RTCManager::getCurrentTime() {\r\n    if (!rtcReady) {\r\n        // Fallback dummy time if RTC not ready\r\n        return DateTime(2000, 1, 1, 0, 0, 0);\r\n    }\r\n    return rtc.now();\r\n}\r\n\r\nvoid RTCManager::setTime(uint16_t year, uint16_t month, uint16_t day,\r\n                         uint16_t hour, uint16_t minute, uint16_t second) {\r\n    if (!rtcReady) {\r\n        Serial.println(\"RTC not ready, cannot set time\");\r\n        return;\r\n    }\r\n\r\n    rtc.adjust(DateTime(year, month, day, hour, minute, second));\r\n    Serial.println(\"RTC time updated\");\r\n\r\n    updateHomePageTime();\r\n    updateSettingsButton();\r\n}\r\n\r\nvoid RTCManager::updateHomePageTime() {\r\n    if (!home_time_label) {\r\n        // UI not bound yet\r\n        return;\r\n    }\r\n\r\n    if (!rtcReady) {\r\n        lv_label_set_text(home_time_label, \"RTC ERR\");\r\n        return;\r\n    }\r\n\r\n    DateTime now = rtc.now();\r\n\r\n    // 🔹 Format: DD-MM-YYYY HH:MM\r\n    char buf[32];\r\n    snprintf(buf, sizeof(buf),\r\n             \"%02d-%02d-%04d %02d:%02d\",\r\n             now.day(), now.month(), now.year(),\r\n             now.hour(), now.minute());\r\n\r\n    lv_label_set_text(home_time_label, buf);\r\n}\r\n\r\nvoid RTCManager::updateSettingsButton() {\r\n    if (!settings_button) return;\r\n\r\n    const char *txt = rtcReady ? \"RTC OK\" : \"RTC ERR\";\r\n\r\n    // If settings_button is a button with a child label\r\n    if (lv_obj_check_type(settings_button, &lv_btn_class)) {\r\n        lv_obj_t *label = lv_obj_get_child(settings_button, 0);\r\n        if (label && lv_obj_check_type(label, &lv_label_class)) {\r\n            lv_label_set_text(label, txt);\r\n        }\r\n    } else {\r\n        // If it's directly a label\r\n        lv_label_set_text(settings_button, txt);\r\n    }\r\n}\r\n\r\n/* ------------ Calendar Popup (simple version) ------------ */\r\n\r\nvoid RTCManager::createCalendarPopup() {\r\n    if (!rtcReady) {\r\n        Serial.println(\"RTC not ready, cannot show calendar popup\");\r\n        return;\r\n    }\r\n\r\n    // Close previous popup if any\r\n    closeCalendarPopup();\r\n\r\n    DateTime now = rtc.now();\r\n\r\n    // Simple popup showing current date & time\r\n    calendar_popup = lv_msgbox_create(NULL, \"RTC Time\", \"\", NULL, true);\r\n\r\n    char buf[64];\r\n    snprintf(buf, sizeof(buf),\r\n             \"%02d-%02d-%04d\\n%02d:%02d:%02d\",\r\n             now.day(), now.month(), now.year(),\r\n             now.hour(), now.minute(), now.second());\r\n\r\n    lv_msgbox_set_text(calendar_popup, buf);\r\n    lv_obj_center(calendar_popup);\r\n}\r\n\r\nvoid RTCManager::closeCalendarPopup() {\r\n    if (calendar_popup) {\r\n        lv_obj_del(calendar_popup);\r\n        calendar_popup = nullptr;\r\n    }\r\n}\r\n\r\nvoid RTCManager::showCalendarPopup() {\r\n    createCalendarPopup();\r\n}\r\n\r\n/* ------------ Static Callbacks ------------ */\r\n\r\nvoid RTCManager::timerCallback(lv_timer_t *timer) {\r\n    // user_data holds RTCManager* (passed when timer created)\r\n    RTCManager *self = static_cast<RTCManager *>(timer->user_data);\r\n\r\n    if (!self) {\r\n        self = &rtcManager;  // fallback to global instance\r\n    }\r\n\r\n    self->updateHomePageTime();\r\n}\r\n\r\nvoid RTCManager::buttonCallback(lv_event_t *e) {\r\n    if (lv_event_get_code(e) != LV_EVENT_CLICKED) return;\r\n\r\n    // Use the global instance\r\n    rtcManager.showCalendarPopup();\r\n}\r\n"}}
